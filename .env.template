# Caminho do cofre onde os componentes são guardados/versionados.
# ~ é expandido para o home do usuário.
PATH_COFRE=~/wordpress

# Backend de download: 'http' (direto, sem dependências) ou 'craudiowebot'.
FETCH_BACKEND=http

# --- craudiowebot (usado apenas quando FETCH_BACKEND=craudiowebot) ---
# CRAUDIOWEBOT_HOST=127.0.0.1
# CRAUDIOWEBOT_PORT=11015
# CRAUDIOWEBOT_FETCH_PATH=/fetch
# CRAUDIOWEBOT_URL_PARAM=url
# CRAUDIOWEBOT_TIMEOUT=120
